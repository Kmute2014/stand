rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Users collection - restrict CRUD operations to admins
    match /users/{userId} {
      // Allow everyone to read users (needed for UI)
      allow read: if request.auth != null;
      
      // Allow users to update their own document (but not role/status)
      allow update: if request.auth.uid == userId && 
                       !request.resource.data.role.changedIfExists() &&
                       !request.resource.data.status.changedIfExists();
      
      // Allow only admins to create users
      allow create: if isAdmin();
      
      // Allow only admins to update any user document (including role/status)
      allow delete: if isAdmin();
      allow update: if isAdmin();
    }

    // Responses collection
    match /responses/{responseId} {
      // Allow users to read all responses (for dashboard/responses page)
      allow read: if request.auth != null;
      
      // Allow users to create their own responses
      allow create: if request.auth != null && 
                       request.resource.data.userId == request.auth.uid;
      
      // Allow users to update their own responses
      allow update: if request.auth.uid == get(/databases/$(database)/documents/responses/$(responseId)).data.userId;
      
      // Allow only admins to delete responses
      allow delete: if isAdmin();
    }

    // Settings collection - allow only admins
    match /settings/{document=**} {
      allow read, write: if isAdmin();
    }

    // Deny all other operations by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
