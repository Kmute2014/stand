# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JIRA Configuration
# JIRA instance URL (e.g., https://yourcompany.atlassian.net)
JIRA_BASE_URL="YOUR_JIRA_URL"
# JIRA email address for authentication
JIRA_EMAIL="your.email@example.com"
# JIRA API token (generate from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN="your-api-token"
