# AI API Keys - Google Gemini is recommended for this application
# Google Gemini API Key (for Gemini Pro) - PRIMARY PROVIDER
GEMINI_API_KEY="your-gemini-api-key-here"

# Alternative providers (optional)
# OpenAI API Key (for GPT-3.5, GPT-4)
REACT_APP_OPENAI_API_KEY="your-openai-api-key-here"

# Anthropic API Key (for Claude)
REACT_APP_ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
